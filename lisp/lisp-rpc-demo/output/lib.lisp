(defpackage DEMO
  (:use #:cl #:lisp-rpc-util)
  (:export
   #:LANGUAGE-PREFERENCE-P
   #:MAKE-LANGUAGE-PREFERENCE
   #:LANGUAGE-PREFERENCE
   #:LANGUAGE-PREFERENCE-LANG
   #:BOOK-INFO-P
   #:MAKE-BOOK-INFO
   #:BOOK-INFO
   #:BOOK-INFO-LANG
   #:BOOK-INFO-TITLE
   #:BOOK-INFO-VERSION
   #:BOOK-INFO-ID
   #:AUTHORS-P
   #:MAKE-AUTHORS
   #:AUTHORS
   #:AUTHORS-NAMES
   #:GET-BOOK-P
   #:MAKE-GET-BOOK
   #:GET-BOOK
   #:GET-BOOK-TITLE
   #:GET-BOOK-VERSION
   #:GET-BOOK-LANG-ENCODING
   #:GET-BOOK-LANG-LANG
   #:GET-BOOK-LANG
   #:MAKE-GET-BOOK-LANG
   #:GET-BOOK-LANG-P
   #:GET-BOOK-AUTHORS
   #:PING-NO-PONG-P
   #:MAKE-PING-NO-PONG
   #:PING-NO-PONG
   #:PING-NO-PONG-NOTHING))

(in-package :DEMO)

(DEFSTRUCT LANGUAGE-PREFERENCE (LANG "" :TYPE STRING))

(DEFMETHOD TO-LISP-RPC-DATA
           ((X LANGUAGE-PREFERENCE) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(LANGUAGE-PREFERENCE ~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'LANG (TO-LISP-RPC-DATA (LANGUAGE-PREFERENCE-LANG X))))))

(DEFSTRUCT BOOK-INFO
  (LANG NIL :TYPE LANGUAGE-PREFERENCE)
  (TITLE "" :TYPE STRING)
  (VERSION "" :TYPE STRING)
  (ID "" :TYPE STRING))

(DEFMETHOD TO-LISP-RPC-DATA ((X BOOK-INFO) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(BOOK-INFO ~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'LANG (TO-LISP-RPC-DATA (BOOK-INFO-LANG X)))
                (LIST 'TITLE (TO-LISP-RPC-DATA (BOOK-INFO-TITLE X)))
                (LIST 'VERSION (TO-LISP-RPC-DATA (BOOK-INFO-VERSION X)))
                (LIST 'ID (TO-LISP-RPC-DATA (BOOK-INFO-ID X))))))

(DEFSTRUCT AUTHORS (NAMES NIL :TYPE (CONS STRING)))

(DEFMETHOD TO-LISP-RPC-DATA ((X AUTHORS) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(AUTHORS ~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'NAMES (TO-LISP-RPC-DATA (AUTHORS-NAMES X))))))

(DEFSTRUCT GET-BOOK-LANG (LANG "" :TYPE STRING) (ENCODING 0 :TYPE NUMBER))

(DEFMETHOD TO-LISP-RPC-DATA
           ((X GET-BOOK-LANG) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'LANG (TO-LISP-RPC-DATA (GET-BOOK-LANG-LANG X)))
                (LIST 'ENCODING
                      (TO-LISP-RPC-DATA (GET-BOOK-LANG-ENCODING X))))))

(DEFSTRUCT GET-BOOK
  (TITLE "" :TYPE STRING)
  (VERSION "" :TYPE STRING)
  (LANG NIL :TYPE GET-BOOK-LANG)
  (AUTHORS NIL :TYPE AUTHORS))

(DEFMETHOD TO-LISP-RPC-DATA ((X GET-BOOK) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(GET-BOOK ~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'TITLE (TO-LISP-RPC-DATA (GET-BOOK-TITLE X)))
                (LIST 'VERSION (TO-LISP-RPC-DATA (GET-BOOK-VERSION X)))
                (LIST 'LANG (TO-LISP-RPC-DATA (GET-BOOK-LANG X)))
                (LIST 'AUTHORS (TO-LISP-RPC-DATA (GET-BOOK-AUTHORS X))))))

(DEFMETHOD RPC-ENDPOINT-P ((REQ GET-BOOK)) T)

(DEFMETHOD RPC-RESPONSE-TYPE ((REQ GET-BOOK)) 'BOOK-INFO)

(DEFSTRUCT PING-NO-PONG (NOTHING "" :TYPE STRING))

(DEFMETHOD TO-LISP-RPC-DATA
           ((X PING-NO-PONG) &REST ARGS &KEY &ALLOW-OTHER-KEYS)
  (DECLARE (IGNORE ARGS))
  (FORMAT NIL "(PING-NO-PONG ~{:~1{~A ~A~}~^ ~})"
          (LIST (LIST 'NOTHING (TO-LISP-RPC-DATA (PING-NO-PONG-NOTHING X))))))

(DEFMETHOD RPC-ENDPOINT-P ((REQ PING-NO-PONG)) T)

(DEFMETHOD RPC-RESPONSE-TYPE ((REQ PING-NO-PONG)) 'NIL)

